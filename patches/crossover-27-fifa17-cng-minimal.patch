+/* PKCS12_ALWAYS_CNG_KSP asks for the key to live in a CNG key storage
+ * provider rather than a legacy CryptoAPI container, and to be attached to the
+ * certificate through CERT_NCRYPT_KEY_HANDLE_PROP_ID.  .NET always asks for
+ * this, and without it the imported certificate appears to have no usable key. */
+static NCRYPT_KEY_HANDLE import_key_cng( cert_store_data_t data )
+{
+    DWORD size = 0, cng_size = 0;
+    struct import_store_key_params params = { data, NULL, &size };
+    NCRYPT_PROV_HANDLE prov = 0;
+    NCRYPT_KEY_HANDLE key = 0;
+    BYTE *ms = NULL, *cng = NULL;
+
+    if (CRYPT32_CALL( import_store_key, &params ) != STATUS_BUFFER_TOO_SMALL) return 0;
+    if (!(ms = CryptMemAlloc( size ))) return 0;
+    params.buf = ms;
+    if (CRYPT32_CALL( import_store_key, &params )) goto done;
+
+    if (!(cng = ms_blob_to_bcrypt_blob( ms, size, &cng_size ))) goto done;
+
+    if (NCryptOpenStorageProvider( &prov, L"Microsoft Software Key Storage Provider", 0 ))
+    {
+        WARN( "NCryptOpenStorageProvider failed\n" );
+        goto done;
+    }
+    if (NCryptImportKey( prov, 0, BCRYPT_RSAFULLPRIVATE_BLOB, NULL, &key, cng, cng_size, 0 ))
+    {
+        WARN( "NCryptImportKey failed\n" );
+        key = 0;
+    }
+
+done:
+    /* Wine's ncrypt records the provider handle on the key as
+     * NCRYPT_PROVIDER_HANDLE_PROPERTY (ncrypt/main.c, create_key_object), and .NET
+     * reads it back into a SafeNCryptProviderHandle that it frees when it disposes
+     * the CngKey.  Freeing it here as well leaves the key holding a pointer to
+     * freed memory, and NCryptFreeObject reads object->type straight from the
+     * handle -- so the caller's own Dispose takes an access violation.  Hand
+     * ownership to the key instead, and release the provider only when there is no
+     * key to own it. */
+    if (prov && !key) NCryptFreeObject( prov );
+    CryptMemFree( cng );
+    CryptMemFree( ms );
+    return key;
+}
+
+/* Whether this certificate's public key is the one just imported.
+ *  1  it is        0  it is not        -1  could not tell
+ *
+ * PFXImportCertStore attached the imported key to every certificate in the
+ * store, CA certificates included.  Setting CERT_NCRYPT_KEY_HANDLE_PROP_ID
+ * releases the handle it replaces, and the store releases it once more per
+ * context, so one handle spread across N certificates is freed N times.  A
+ * single-certificate PFX -- all this has ever been used with -- never showed it.
+ *
+ * The two sides store the modulus in opposite byte orders, so compare it
+ * end-to-end rather than with memcmp.  "Could not tell" is distinct from "no",
+ * because the caller uses it to fall back to the old behaviour of attaching to
+ * the first certificate: still wrong on a chain, but wrong once, not N times. */
+static int cert_key_match( PCCERT_CONTEXT cert, NCRYPT_KEY_HANDLE key )
+{
+    const CRYPT_BIT_BLOB *spk = &cert->pCertInfo->SubjectPublicKeyInfo.PublicKey;
+    BCRYPT_RSAKEY_BLOB *pub = NULL;
+    BLOBHEADER *hdr = NULL;
+    const RSAPUBKEY *rsapub;
+    const BYTE *cng_m, *ms_m;
+    DWORD size = 0, len = 0, i;
+    int ret = -1;
+
+    if (NCryptExportKey( key, 0, BCRYPT_RSAPUBLIC_BLOB, NULL, NULL, 0, &size, 0 ) || !size) return -1;
+    if (!(pub = CryptMemAlloc( size ))) return -1;
+    if (NCryptExportKey( key, 0, BCRYPT_RSAPUBLIC_BLOB, NULL, (BYTE *)pub, size, &size, 0 )) goto done;
+    if (size < sizeof(*pub)) goto done;
+    if ((ULONGLONG)pub->cbPublicExp + pub->cbModulus > size - sizeof(*pub)) goto done;
+
+    if (!CryptDecodeObjectEx( X509_ASN_ENCODING, RSA_CSP_PUBLICKEYBLOB, spk->pbData, spk->cbData,
+                              CRYPT_DECODE_ALLOC_FLAG, NULL, &hdr, &len )) goto done;
+    if (len < sizeof(*hdr) + sizeof(*rsapub)) goto done;
+    rsapub = (const RSAPUBKEY *)(hdr + 1);
+
+    /* from here on the comparison is meaningful, so an answer of "no" is real */
+    ret = 0;
+    if (rsapub->bitlen != pub->BitLength) goto done;
+    if (rsapub->bitlen / 8 != pub->cbModulus) goto done;
+    if (len < sizeof(*hdr) + sizeof(*rsapub) + pub->cbModulus) goto done;
+
+    cng_m = (const BYTE *)pub + sizeof(*pub) + pub->cbPublicExp;   /* big endian */
+    ms_m  = (const BYTE *)(rsapub + 1);                            /* little endian */
+    for (i = 0; i < pub->cbModulus; i++)
+        if (cng_m[i] != ms_m[pub->cbModulus - 1 - i]) goto done;
+    ret = 1;
+
+done:
+    LocalFree( hdr );
+    CryptMemFree( pub );
+    return ret;
+}
