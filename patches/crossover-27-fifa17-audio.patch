+/***********************************************************************
+ *              capture_authorized
+ *
+ * Whether this process may record audio, asked once and cached.
+ *
+ * Every path that touches an input AudioUnit has to come through here first.
+ * Enabling input IO on an AUHAL, or merely querying it, makes the CoreAudio HAL
+ * do a synchronous round trip to coreaudiod; if the process has no capture
+ * authorization that call never returns, and it takes the caller's lock with it.
+ * The result is cached because the permission request itself is slow, and
+ * is_format_supported can be called many times during startup.
+ */
+/* Must match AUTH_TIMED_OUT in authorization.m.  Duplicated rather than added to
+ * coreaudio_cocoa.h, which this patch does not otherwise touch. */
+#define AUTH_TIMED_OUT (-2)
+
+static BOOL capture_authorized(void)
+{
+    static int cached = -1;
+    int status, done;
+    BOOL requested, permitted;
+
+    /* Benign race on the cache: both threads compute the same answer.  Read and
+     * write it atomically so the value seen is one that was actually stored. */
+    if ((done = __atomic_load_n(&cached, __ATOMIC_ACQUIRE)) != -1) return done;
+
+    status = CoreAudio_get_capture_authorization_status();
+    TRACE("Audio capture authorization status: %d\n", status);
+
+    requested = (status == NOT_DETERMINED);
+    if (requested)
+        status = CoreAudio_request_capture_authorization();
+
+    if (status == AUTH_TIMED_OUT)
+    {
+        /* The dialog did not answer in time, which is not the same as the user
+         * saying no.  Caching it would disable capture for the life of the process
+         * because the machine happened to be busy at launch.  Fail this call and
+         * ask again on the next one. */
+        WARN("Audio capture permission request timed out; not caching the result.\n");
+        return FALSE;
+    }
+
+    permitted = requested ? (status == 1) : (status == AUTHORIZED);
+    if (!permitted)
+        ERR_(winediag)("Microphone/audio capture permission was denied. "
+                       "This can be enabled under Security & Privacy in System Preferences.\n");
+
+    __atomic_store_n(&cached, permitted, __ATOMIC_RELEASE);
+    return permitted;
+}
+
