-int CoreAudio_request_capture_authorization(void)
+/* Must match AUTH_TIMED_OUT in coreaudio.c.  A timeout is reported separately
+ * from a denial so the caller can decline to cache it. */
+#define AUTH_TIMED_OUT (-2)
+
+/* Shared between this function and the completion handler, because the wait is
+ * bounded: if we give up first the handler may still run afterwards, and it must
+ * not write to a stack frame that is already gone.  Last one out frees it. */
+struct capture_auth_request
 {
-    __block int ret = -1;
     dispatch_semaphore_t semaphore;
+    int granted;
+    int refcount;
+};
+
+static void capture_auth_release(struct capture_auth_request *req)
+{
+    if (__sync_sub_and_fetch(&req->refcount, 1) == 0)
+    {
+        dispatch_release(req->semaphore);
+        free(req);
+    }
+}
+
+int CoreAudio_request_capture_authorization(void)
+{
+    struct capture_auth_request *req;
     NSAutoreleasePool* pool = [[NSAutoreleasePool alloc] init];
+    int ret = -1;
 
     if ([AVCaptureDevice respondsToSelector:@selector(requestAccessForMediaType:completionHandler:)])
     {
+        if (!(req = calloc(1, sizeof(*req))))
+        {
+            [pool release];
+            return -1;
+        }
+        req->semaphore = dispatch_semaphore_create(0);
+        req->granted   = -1;
+        req->refcount  = 2;   /* this function, and the completion handler */
+
         [[NSNotificationCenter defaultCenter] postNotificationName:WineWillShowPermissionDialogNotification
                                                             object:nil];
-        semaphore = dispatch_semaphore_create(0);
         [AVCaptureDevice requestAccessForMediaType:AVMediaTypeAudio
                                  completionHandler:^(BOOL granted){
-            dispatch_semaphore_signal(semaphore);
-            ret = granted ? 1 : 0;
+            req->granted = granted ? 1 : 0;
+            dispatch_semaphore_signal(req->semaphore);
+            capture_auth_release(req);
         }];
 
-        dispatch_semaphore_wait(semaphore, DISPATCH_TIME_FOREVER);
-        dispatch_release(semaphore);
+        /* Bounded, not DISPATCH_TIME_FOREVER: the permission dialog is shown by
+         * the responsible process, and if it can never be shown -- an unsigned or
+         * ad-hoc signed host, a session with no UI -- an unbounded wait hangs the
+         * caller for the life of the process while it holds the audio client's
+         * lock.  Treat a timeout as "not granted" and let the caller fail cleanly. */
+        if (dispatch_semaphore_wait(req->semaphore,
+                                    dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC)))
+            ret = AUTH_TIMED_OUT;
+        else
+            ret = req->granted;
+
         [[NSNotificationCenter defaultCenter] postNotificationName:WineDidShowPermissionDialogNotification
                                                             object:nil];
+        capture_auth_release(req);
     }
 
     [pool release];
