+/***********************************************************************
+ *              device_is_excluded
+ *
+ * Skip devices whose name matches WINE_COREAUDIO_EXCLUDE (a comma-separated
+ * list of substrings, case-insensitive).
+ *
+ * A third-party HAL plugin that stops answering wedges every process that so
+ * much as points an AudioUnit at its device -- the call is a synchronous round
+ * trip into coreaudiod and there is no timeout to reach for.  An application
+ * that enumerates endpoints and probes each one then hangs on startup through
+ * no fault of its own.  This lets such a device be skipped without uninstalling
+ * the driver system-wide.
+ */
+static BOOL device_is_excluded(CFStringRef name)
+{
+    static const char *exclude;
+    static BOOL looked_up;
+    char buf[512], *list, *tok, *ctx, *end;
+    BOOL ret = FALSE;
+
+    /* Benign race: getenv is idempotent and every thread computes the same
+     * answer.  Worth doing because this runs once per device per enumeration. */
+    if(!looked_up){
+        exclude = getenv("WINE_COREAUDIO_EXCLUDE");
+        looked_up = TRUE;
+    }
+
+    if(!exclude || !*exclude || !name) return FALSE;
+    /* A name too long for buf cannot be matched at all, so give it real room:
+     * failing to exclude a device is the failure that hangs the process. */
+    if(!CFStringGetCString(name, buf, sizeof(buf), kCFStringEncodingUTF8)) return FALSE;
+    if(!(list = strdup(exclude))) return FALSE;
+
+    for(tok = strtok_r(list, ",", &ctx); tok; tok = strtok_r(NULL, ",", &ctx)){
+        /* Trim both ends.  Trimming only the front means "A , B" -- which the
+         * documented comma-separated form invites -- silently never matches. */
+        while(*tok == ' ' || *tok == '\t') tok++;
+        end = tok + strlen(tok);
+        while(end > tok && (end[-1] == ' ' || end[-1] == '\t')) *--end = 0;
+        if(*tok && strcasestr(buf, tok)){
+            WARN("Skipping excluded audio device \"%s\" (matched \"%s\")\n", buf, tok);
+            ret = TRUE;
+            break;
+        }
+    }
+    free(list);
+    return ret;
+}
