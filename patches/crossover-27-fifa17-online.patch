+/*
+ * A PFX imported with PKCS12_NO_PERSIST_KEY may carry its private key only
+ * through its certificate's provider, not in the Wine Crypto\RSA registry.
+ * Export it from the CAPI provider and convert the PRIVATEKEYBLOB to the
+ * BCRYPT_RSAFULLPRIVATE_BLOB required by the current GnuTLS backend.
+ */
+static BYTE *get_key_blob_from_provider(const CERT_CONTEXT *ctx, DWORD *size)
+{
+    HCRYPTPROV_OR_NCRYPT_KEY_HANDLE prov = 0;
+    HCRYPTKEY key = 0;
+    DWORD spec = 0, blob_size = 0;
+    BOOL free_prov = FALSE;
+    BYTE *capi_blob = NULL, *ret = NULL;
+
+    if (!CryptAcquireCertificatePrivateKey(ctx, CRYPT_ACQUIRE_CACHE_FLAG,
+                                           NULL, &prov, &spec, &free_prov))
+        return NULL;
+
+    /* The NCrypt path is handled by get_key_blob_ncrypt(). */
+    if (spec == CERT_NCRYPT_KEY_SPEC)
+    {
+        if (free_prov) NCryptFreeObject((NCRYPT_KEY_HANDLE)prov);
+        return NULL;
+    }
+    if (spec != AT_KEYEXCHANGE && spec != AT_SIGNATURE) goto done;
+
+    if (!CryptGetUserKey((HCRYPTPROV)prov, spec, &key) &&
+        !CryptGetUserKey((HCRYPTPROV)prov,
+                         spec == AT_KEYEXCHANGE ? AT_SIGNATURE : AT_KEYEXCHANGE, &key))
+        goto done;
+
+    if (!CryptExportKey(key, 0, PRIVATEKEYBLOB, 0, NULL, &blob_size)) goto done;
+    if (!(capi_blob = malloc(blob_size))) goto done;
+    if (CryptExportKey(key, 0, PRIVATEKEYBLOB, 0, capi_blob, &blob_size))
+        ret = convert_capi_to_bcrypt(capi_blob, blob_size, size);
+
+done:
+    free(capi_blob);
+    if (key) CryptDestroyKey(key);
+    if (free_prov) CryptReleaseContext((HCRYPTPROV)prov, 0);
+    return ret;
+}
