+/***********************************************************************
+ *           clip_to_image_section
+ *
+ * Windows maps every PE section of an image as its own subsection of the
+ * section object, and NtQueryVirtualMemory never returns a region that
+ * crosses one of those boundaries -- VirtualQuery on a module always stops
+ * at the end of the section the address falls in, even when the next
+ * section happens to carry the same page protection.  Wine only tracks
+ * per-page protection, so it happily merges neighbouring sections and
+ * reports a region that runs past the end of the section.  Anti-tamper code
+ * that validates a page before patching it compares RegionSize against the
+ * section extent and rejects the process when it does not match.
+ *
+ * Clip the reported region at the boundary of the containing section.
+ * virtual_mutex must be held by caller.
+ */
+static SIZE_T clip_to_image_section( struct file_view *view, const char *base, SIZE_T size )
+{
+    const IMAGE_DOS_HEADER *dos = (const IMAGE_DOS_HEADER *)view->base;
+    const IMAGE_NT_HEADERS *nt;
+    const IMAGE_SECTION_HEADER *sec;
+    SIZE_T offset = base - (char *)view->base;
+    SIZE_T start, end;
+    UINT i, count;
+
+    if (!(view->protect & SEC_IMAGE)) return size;
+    if (view->size < page_size || !size) return size;
+    if (!(get_page_vprot( (char *)view->base ) & VPROT_READ)) return size;
+    if (dos->e_magic != IMAGE_DOS_SIGNATURE) return size;
+    /* e_lfanew is a signed LONG.  A negative one is currently rejected only
+     * because it converts to a huge unsigned value for this comparison, which is
+     * the right answer by the wrong route in a function that then dereferences
+     * guest-controlled mapped memory.  Reject it on its own terms. */
+    if (dos->e_lfanew < 0 || (SIZE_T)dos->e_lfanew > page_size - sizeof(*nt)) return size;
+
+    nt = (const IMAGE_NT_HEADERS *)((const char *)dos + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE) return size;
+
+    count = nt->FileHeader.NumberOfSections;
+    if (!count) return size;
+    if (dos->e_lfanew + FIELD_OFFSET( IMAGE_NT_HEADERS, OptionalHeader ) +
+        nt->FileHeader.SizeOfOptionalHeader + count * sizeof(*sec) > page_size) return size;
+
+    sec = IMAGE_FIRST_SECTION( nt );
+
+    /* the PE headers are a subsection of their own */
+    if (offset < sec[0].VirtualAddress)
+        return min( size, sec[0].VirtualAddress - offset );
+
+    for (i = 0; i < count; i++)
+    {
+        start = sec[i].VirtualAddress;
+        if (offset < start) continue;
+        end = (i + 1 < count && sec[i + 1].VirtualAddress > start) ? sec[i + 1].VirtualAddress : view->size;
+        if (offset < end) return min( size, end - offset );
+    }
+    return size;
 }
 
 
